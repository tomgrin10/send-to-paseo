{
  "name": "send-to-paseo",
  "type": "module",
  "version": "1.3.0",
  "license": "MIT",
  "description": "Local HTTP bridge that dispatches PR work to the right Paseo workspace and agent.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomgrin10/send-to-paseo.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/tomgrin10/send-to-paseo#readme",
  "bugs": "https://github.com/tomgrin10/send-to-paseo/issues",
  "author": "Tom Gringauz",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "github",
    "graphite",
    "pull-request"
  ],
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/**/*.ts",
    "client/**/*.tsx",
    "server/**/*.ts",
    "shared/**/*.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node check-deps.mjs && node --test client/hosts.test.mjs server/main-agent.test.mjs",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@getpaseo/client": "0.9.0",
    "@getpaseo/plugin": "0.9.0",
    "@getpaseo/protocol": "0.9.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.10.2",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
